# https://www.notion.so/my-integrations 에서 발급한 Secret
NOTION_TOKEN=ntn_xxxxxxxx

# 기본 DB (테마 없거나 매핑 안 된 테마)
NOTION_DATABASE_ID=8f4ffc9fd7224bb78f7e3ac530fd526b

# 테마별 DB (1줄 JSON). 카톡 1줄=테마 이름과 키가 같아야 함
NOTION_THEME_DATABASES={"주식":"aea7efcd5a7f491784f4a3afec133edf","일본어":"62efed56bd46467592d2084aae894ef9"}

# 선택: 웹 업로더 주소 (비우면 현재 Vercel 도메인을 자동 사용)
WEB_UPLOADER_URL=

# 선택: 업로드 API 보호용 (비워두면 로컬에서는 자유)
UPLOAD_SECRET=

# 선택: 웹 업로더(브라우저)가 헤더(x-upload-secret)를 붙이려면
# NEXT_PUBLIC_UPLOAD_SECRET 도 같이 설정해 주세요.
NEXT_PUBLIC_UPLOAD_SECRET=

# 선택: 카카오 사용자 ID 화이트리스트
# 첫 테스트 후 Notion 메모/Vercel 로그에서 user id 확인하고 쉼표로 추가
KAKAO_ALLOWED_USER_IDS=
