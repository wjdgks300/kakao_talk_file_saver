# https://www.notion.so/my-integrations 에서 발급한 Secret
NOTION_TOKEN=ntn_xxxxxxxx

# 카톡 수신함 DB ID (URL의 32자리 또는 하이픈 포함 UUID)
# 예: https://www.notion.so/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx → 그 부분
NOTION_DATABASE_ID=8f4ffc9fd7224bb78f7e3ac530fd526b

# 선택: 업로드 API 보호용 (비워두면 로컬에서는 자유)
UPLOAD_SECRET=

# 선택: 카카오 사용자 ID 화이트리스트
# 첫 테스트 후 Notion 메모/Vercel 로그에서 user id 확인하고 쉼표로 추가
KAKAO_ALLOWED_USER_IDS=
